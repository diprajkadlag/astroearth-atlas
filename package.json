{
  "name": "astroearth-atlas",
  "version": "0.0.0",
  "private": true,
  "description": "AstroEarth Atlas: an interactive 3D Earth and planetary time waves for Vedic mundane astrology (Lahiri sidereal zodiac), 1900 to 2050.",
  "keywords": [
    "jyotish",
    "vedic-astrology",
    "mundane-astrology",
    "astronomy",
    "threejs",
    "webgl",
    "data-visualization"
  ],
  "license": "MIT",
  "author": "Dipraj Kadlag",
  "homepage": "https://github.com/diprajkadlag/astroearth-atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diprajkadlag/astroearth-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/diprajkadlag/astroearth-atlas/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "licenses": "node scripts/check-licenses.mjs",
    "licenses:write": "node scripts/check-licenses.mjs --write",
    "data": "node --no-warnings scripts/generate-sky-data.ts",
    "data:check": "node --no-warnings scripts/generate-sky-data.ts --check",
    "horizons": "node --no-warnings scripts/fetch-horizons-reference.ts",
    "textures": "node --no-warnings scripts/make-earth-textures.ts",
    "release-check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "astronomy-engine": "2.1.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "marked": "18.0.14",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
